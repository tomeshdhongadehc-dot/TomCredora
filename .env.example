# --- AI (required for "Tailor with AI") ---
# Free key: https://aistudio.google.com/apikey . Users can also bring their own key in the UI.
GEMINI_API_KEY=
# Optional: comma-separated model fallback chain. Default: gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-flash-latest
# Free tier is ~20 requests/day per model; models get retired (gemini-2.5-* already 404s). List what your key can use:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=

# --- Shared rate limiting + idempotency (required in production on Vercel) ---
# Free Redis: https://upstash.com . Without these, limits are per-instance (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Accounts + cloud sync (optional; the app works fully without them). See README "Accounts and sync" ---
# Run supabase/migrations/0001_init.sql and 0002_user_data.sql, then paste the project URL and the ANON key (never the service key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# --- Public site (set both in production; used for the sitemap, canonical links, share cards and the legal pages) ---
# The public address, with https and no trailing slash, e.g. https://yourdomain.com . Without it, links use http://localhost:3200.
NEXT_PUBLIC_SITE_URL=
# Shown on the Privacy and Terms pages so people can reach you. The line is left out when empty.
NEXT_PUBLIC_CONTACT_EMAIL=

# Test/demo only: a fake sign-in that needs no Supabase. Refused when NODE_ENV=production. Set both or neither.
# AUTH_MODE=mock
# NEXT_PUBLIC_AUTH_MODE=mock

# Show "Continue with Google" on the sign-in page. Set to 1 only after enabling the Google provider in Supabase.
# NEXT_PUBLIC_AUTH_GOOGLE=
